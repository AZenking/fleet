{
  "name": "@fleet/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet 可观测层：Run 持久化（.fleet/runs/）+ 事件流视图重建 + Resume + 孤儿清理",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project observability"
  },
  "dependencies": {
    "@fleet/budget": "workspace:*",
    "@fleet/core": "workspace:*",
    "@fleet/mission": "workspace:*",
    "@fleet/scheduler": "workspace:*",
    "@fleet/validation": "workspace:*",
    "@fleet/workspace": "workspace:*",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
