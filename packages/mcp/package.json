    "@fleet/observability": "workspace:*",
    "@fleet/repository": "workspace:*",
    "@fleet/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
