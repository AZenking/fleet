{
  "name": "@fleet/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet MCP 暴露层：零依赖 stdio JSON-RPC 协议循环 + Repository Intelligence / Fleet 工具装配",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
