{
  "name": "@fleet/validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet 独立验收层：Validation Runner（diff/lint/typecheck/tests）+ Wisdom 审阅循环（上限强制）",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project validation"
  },
  "dependencies": {
    "@fleet/agents": "workspace:*",
    "@fleet/context": "workspace:*",
    "@fleet/core": "workspace:*",
    "@fleet/mission": "workspace:*",
    "@fleet/runtime": "workspace:*",
    "@fleet/scheduler": "workspace:*",
    "@fleet/workspace": "workspace:*",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
