{
  "name": "@fleet/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet 运行时层：RuntimeAdapter 契约 + FakeRuntimeAdapter + 任务桥接与 mission 编排",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --project runtime"
  },
  "dependencies": {
    "@fleet/core": "workspace:*",
    "@fleet/mission": "workspace:*",
    "@fleet/scheduler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
