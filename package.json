    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^10.0.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
