{
  "name": "agent-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Fleet — 多 Agent 软件工程运行时（Reflex / Focus / Reason / Insight / Wisdom）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
